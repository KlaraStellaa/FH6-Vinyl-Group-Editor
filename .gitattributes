# Line endings: store as LF
* text=auto eol=lf

# Windows batch: force CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.exe  binary
*.dll  binary
*.node binary
*.7z   binary
*.zip  binary
*.gz   binary
*.ttf  binary
*.woff binary
*.woff2 binary
