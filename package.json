{
  "name": "fh6-vinyl-group-editor",
  "version": "1.4.2",
  "description": "SVG vinyl pattern editor (Electron)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win && node tools/build-portable.js",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.fh6vinylgroup.editor",
    "productName": "FH6 Vinyl Group Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "update-check.js",
      "update-apply.js",
      "update-mirror.js",
      "auto-name.js",
      "workcopy-store.js",
      "keymap.js",
      "font-name.js",
      "dlg-i18n.js",
      "preload.js",
      "forza-cgroup.js",
      "forza-save.js",
      "index.html",
      "js/**/*",
      "css/**/*",
      "assets/**/*",
      "icons/**/*",
      "!**/*.bak*",
      "!icons/*-prev*.ico",
      "!icons/electron-default.ico"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/app-icon.ico"
    },
    "artifactName": "FH6-Vinyl-Group-Editor-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "repository": "https://github.com/KlaraStellaa/fh6-vinyl-group-editor",
  "license": "MIT"
}
